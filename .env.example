# ─────────────────────────────────────────────────────────────────────────────
# Enterprise AI Platform — Environment Configuration Template
# Copy this file to .env and fill in REAL values.
# NEVER commit .env to version control.
# Generate secrets: python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────────────────

# Flask
FLASK_ENV=development
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=REPLACE_WITH_RANDOM_HEX_32
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_HEX_32
JWT_ACCESS_TOKEN_EXPIRES=3600

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=enterprise_ai
DB_USER=app_user
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_ROOT_PASSWORD

# OpenAI / LLM  (optional — system works in local mode without this)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# MLflow  (optional)
MLFLOW_TRACKING_URI=http://localhost:5001

# App
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Rate limiting (requests per minute per IP)
RATELIMIT_DEFAULT=60
RATELIMIT_STORAGE_URL=memory://

# Request size limit in bytes (default 1 MB)
MAX_CONTENT_LENGTH=1048576
